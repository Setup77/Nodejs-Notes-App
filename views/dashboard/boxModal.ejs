<!-- Bouton pour déclencher la Modal -->
<button type="button" class="btn btn-primary rounded-pill px-4 shadow-sm" data-bs-toggle="modal"
  data-bs-target="#addNoteModal">
  <i class="fa fa-plus me-2"></i>Nouvelle Note
</button>

<!-- Fenêtre Modale de Création -->
<div class="modal fade" id="addNoteModal" tabindex="-1" aria-labelledby="addNoteModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content border-0 shadow-lg">

      <div class="modal-header bg-dark text-white border-0">
        <h5 class="modal-title fw-bold" id="addNoteModalLabel">
          <i class="fa fa-pencil-alt me-2 text-primary"></i>Créer une note
        </h5>
        <button type="button" class="btn-close btn-close-white" data-bs-shadow="none" data-bs-dismiss="modal"
          aria-label="Close"></button>
      </div>

      <!-- ⚠️ Formulaire avec validation native désactivée pour laisser Bootstrap gérer -->
      <form action="/dashboard/add" method="POST" enctype="multipart/form-data" id="addNoteForm" novalidate>
        <!-- 🔒 Jeton de protection CSRF indispensable -->
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <div class="modal-body p-4 bg-light">

          <!-- Titre de la Note -->
          <div class="mb-3 position-relative">
            <label for="title" class="form-label fw-semibold text-secondary">Titre</label>
            <input type="text" class="form-control form-control-lg border-0 shadow-sm" id="title" name="title"
              minlength="5" placeholder="Donnez un titre accrocheur..." required>
            <div class="invalid-feedback">Le titre est obligatoire et doit contenir au moins 5 caractères.</div>
            <div class="valid-feedback">Titre valide !</div>
          </div>

          <!-- Type de Note (Texte standard ou Liste de tâches) -->
          <div class="row mb-3">
            <div class="col-12">
              <label for="isTodo" class="form-label fw-semibold text-secondary">Format de note</label>
              <select class="form-select border-0 shadow-sm" id="isTodo" name="isTodo"
                onchange="toggleNoteType(this.value)">
                <option value="false">Texte classique</option>
                <option value="true">To-Do List (Checklist)</option>
              </select>
            </div>
          </div>

          <!-- Zone Contenu Texte Classique -->
          <div class="mb-3" id="textBodyContainer">
            <label for="body" class="form-label fw-semibold text-secondary">Contenu de la note</label>
            <!-- L'ID unique 'noteBody' sert à injecter le fond dégradé dynamiquement -->
            <textarea class="form-control border-0 shadow-sm p-3 transition-all" id="body" name="body" rows="6"
              placeholder="Rédigez votre note ici..."
              style="transition: background 0.3s ease, color 0.3s ease;"></textarea>
            <div class="invalid-feedback">La description/le contenu est obligatoire.</div>
          </div>

          <!-- 🎨 NOUVEAU : Sélecteur de couleur style WhatsApp (Sous la description) -->
          <div class="mb-3">
            <label class="form-label fw-semibold text-secondary d-block">Couleur / Thème de fond</label>
            <input type="hidden" name="colorCategory" id="colorCategory" value="default">
            <div class="d-flex flex-wrap gap-2 p-2 bg-white rounded border shadow-sm">
              <!-- Choix par défaut -->
              <button type="button" class="btn rounded-circle p-0 border border-2 border-dark"
                onclick="selectCardTheme(this, 'default', '#ffffff', '#212529')"
                style="width: 32px; height: 32px; background: #ffffff;" title="Par défaut"></button>

              <!-- Thèmes dynamiques -->
              <button type="button" class="btn rounded-circle p-0"
                onclick="selectCardTheme(this, 'cat-business', 'linear-gradient(135deg, #1e3c72, #2a5298)', '#ffffff')"
                style="width: 32px; height: 32px; background: linear-gradient(135deg, #1e3c72, #2a5298);"
                title="Business"></button>
              <button type="button" class="btn rounded-circle p-0"
                onclick="selectCardTheme(this, 'cat-sport', 'linear-gradient(135deg, #11998e, #38ef7d)', '#ffffff')"
                style="width: 32px; height: 32px; background: linear-gradient(135deg, #11998e, #38ef7d);"
                title="Sport"></button>
              <button type="button" class="btn rounded-circle p-0"
                onclick="selectCardTheme(this, 'cat-tech', 'linear-gradient(135deg, #232526, #414345)', '#ffffff')"
                style="width: 32px; height: 32px; background: linear-gradient(135deg, #232526, #414345);"
                title="Tech"></button>
              <button type="button" class="btn rounded-circle p-0"
                onclick="selectCardTheme(this, 'cat-lifestyle', 'linear-gradient(135deg, #ff9966, #ff5e62)', '#ffffff')"
                style="width: 32px; height: 32px; background: linear-gradient(135deg, #ff9966, #ff5e62);"
                title="Lifestyle"></button>
              <button type="button" class="btn rounded-circle p-0"
                onclick="selectCardTheme(this, 'cat-social', 'linear-gradient(135deg, #833ab4, #fd1d1d, #fcb045)', '#ffffff')"
                style="width: 32px; height: 32px; background: linear-gradient(135deg, #833ab4, #fd1d1d, #fcb045);"
                title="Social"></button>
              <button type="button" class="btn rounded-circle p-0"
                onclick="selectCardTheme(this, 'cat-entertainment', 'linear-gradient(135deg, #6a11cb, #2575fc)', '#ffffff')"
                style="width: 32px; height: 32px; background: linear-gradient(135deg, #6a11cb, #2575fc);"
                title="Divertissement"></button>
              <button type="button" class="btn rounded-circle p-0"
                onclick="selectCardTheme(this, 'cat-health', 'linear-gradient(135deg, #ff0844, #ffb199)', '#ffffff')"
                style="width: 32px; height: 32px; background: linear-gradient(135deg, #ff0844, #ffb199);"
                title="Santé"></button>
              <button type="button" class="btn rounded-circle p-0"
                onclick="selectCardTheme(this, 'cat-travel', 'linear-gradient(135deg, #2193b0, #6dd5ed)', '#ffffff')"
                style="width: 32px; height: 32px; background: linear-gradient(135deg, #2193b0, #6dd5ed);"
                title="Voyage"></button>
              <button type="button" class="btn rounded-circle p-0"
                onclick="selectCardTheme(this, 'cat-gaming', 'linear-gradient(135deg, #b06ab3, #4568dc)', '#ffffff')"
                style="width: 32px; height: 32px; background: linear-gradient(135deg, #b06ab3, #4568dc);"
                title="Gaming"></button>
            </div>
          </div>

          <!-- Zone Liste de Tâches Dynamique (Masquée par défaut) -->
          <div class="mb-3 d-none" id="todoChecklistContainer">
            <label class="form-label fw-semibold text-secondary d-flex justify-content-between align-items-center">
              Éléments de la liste
              <button type="button" class="btn btn-sm btn-outline-primary border-0 rounded-circle"
                onclick="addChecklistItem()">
                <i class="fa fa-plus-circle fa-lg"></i>
              </button>
            </label>
            <div id="checklistFields" class="d-flex flex-column gap-2">
              <div class="input-group shadow-sm">
                <span class="input-group-text bg-white border-0"><i class="fa fa-square text-muted"></i></span>
                <input type="text" name="checklistItems" class="form-control border-0"
                  placeholder="Ex: Acheter du lait...">
              </div>
            </div>
          </div>

          <!-- Tags & Options Rapides -->
          <div class="row align-items-center mt-4">
            <div class="col-md-7 mb-3 mb-md-0">
              <label for="tags" class="form-label fw-semibold text-secondary">Tags (séparés par une virgule)</label>
              <input type="text" class="form-control border-0 shadow-sm" id="tags" name="tags"
                placeholder="travail, important, idées">
            </div>
            <div class="col-md-5 d-flex gap-3 justify-content-md-end pt-3">
              <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" role="switch" id="isPinned" name="isPinned"
                  value="true">
                <label class="form-check-line fw-medium text-dark" for="isPinned">Épingler</label>
              </div>
            </div>
          </div>

          <!-- Champ : Ajout de fichiers joints -->
          <div class="mb-3 mt-3">
            <label for="attachments" class="form-label fw-semibold text-secondary">
              <i class="fa fa-paperclip me-1"></i> Pièces jointes (Images, PDF, Documents, Vidéos)
            </label>
            <input class="form-control border-0 shadow-sm" type="file" id="attachments" name="attachments" multiple>
            <div class="form-text small text-muted">Vous pouvez sélectionner plusieurs fichiers à la fois et annuler
              individuellement.</div>
          </div>

          <!-- Zone de prévisualisation des médias -->
          <div id="mediaPreviewContainer" class="mb-3 d-none">
            <label class="form-label fw-semibold text-secondary">Aperçu des médias sélectionnés</label>
            <div id="mediaPreview" class="d-flex flex-wrap gap-3 p-3 bg-white rounded shadow-sm border"></div>
          </div>

        </div>

        <div class="modal-footer bg-white border-0 p-3 d-flex justify-content-between">
          <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Annuler</button>
          <button type="submit" class="btn btn-primary rounded-pill px-4 shadow-sm" disabled>Enregistrer</button>
        </div>

      </form>

    </div>
  </div>
</div>




<!-- Fenêtre Modale d'Édition Complète -->
<div class="modal fade" id="editNoteModal" tabindex="-1" aria-labelledby="editNoteModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content border-0 shadow-lg">

      <div class="modal-header bg-dark text-white border-0">
        <h5 class="modal-title fw-bold" id="editNoteModalLabel">
          <i class="fa fa-edit me-2 text-primary"></i>Modifier la note
        </h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>

      <form action="" method="POST" enctype="multipart/form-data" id="editNoteForm" novalidate>
        <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">

        <div class="modal-body p-4 bg-light">

          <!-- Titre de la Note -->
          <div class="mb-3 position-relative">
            <label for="editTitle" class="form-label fw-semibold text-secondary">Titre</label>
            <input type="text" class="form-control form-control-lg border-0 shadow-sm" id="editTitle" name="title"
              minlength="5" placeholder="Donnez un titre accrocheur..." required>
            <div class="invalid-feedback">Le titre est obligatoire (min 5 caractères).</div>
          </div>

          <!-- Format de note -->
          <div class="row mb-3">
            <div class="col-12">
              <label for="editIsTodo" class="form-label fw-semibold text-secondary">Format de note</label>
              <select class="form-select border-0 shadow-sm" id="editIsTodo" name="isTodo"
                onchange="toggleEditNoteType(this.value)">
                <option value="false">Texte classique</option>
                <option value="true">To-Do List (Checklist)</option>
              </select>
            </div>
          </div>

          <!-- Zone Contenu Texte Classique -->
          <div class="mb-3" id="editTextBodyContainer">
            <label for="editBody" class="form-label fw-semibold text-secondary">Contenu de la note</label>
            <textarea class="form-control border-0 shadow-sm p-3 transition-all" id="editBody" name="body" rows="6"
              placeholder="Rédigez votre note ici..."
              style="transition: background 0.3s ease, color 0.3s ease;"></textarea>
            <div class="invalid-feedback">Le contenu est obligatoire.</div>
          </div>

          <!-- Thème de fond style WhatsApp -->
          <div class="mb-3">
            <label class="form-label fw-semibold text-secondary d-block">Couleur / Thème de fond</label>
            <input type="hidden" name="colorCategory" id="editColorCategory" value="default">
            <div class="d-flex flex-wrap gap-2 p-2 bg-white rounded border shadow-sm">
              <button type="button" class="btn rounded-circle p-0 edit-color-btn"
                onclick="selectEditCardTheme(this, 'default', '#ffffff', '#212529')"
                style="width:32px; height:32px; background:#ffffff;" title="Par défaut"></button>
              <button type="button" class="btn rounded-circle p-0 edit-color-btn"
                onclick="selectEditCardTheme(this, 'cat-business', 'linear-gradient(135deg, #1e3c72, #2a5298)', '#ffffff')"
                style="width:32px; height:32px; background:linear-gradient(135deg, #1e3c72, #2a5298);"
                title="Business"></button>
              <button type="button" class="btn rounded-circle p-0 edit-color-btn"
                onclick="selectEditCardTheme(this, 'cat-sport', 'linear-gradient(135deg, #11998e, #38ef7d)', '#ffffff')"
                style="width:32px; height:32px; background:linear-gradient(135deg, #11998e, #38ef7d);"
                title="Sport"></button>
              <button type="button" class="btn rounded-circle p-0 edit-color-btn"
                onclick="selectEditCardTheme(this, 'cat-tech', 'linear-gradient(135deg, #232526, #414345)', '#ffffff')"
                style="width:32px; height:32px; background:linear-gradient(135deg, #232526, #414345);"
                title="Tech"></button>
              <button type="button" class="btn rounded-circle p-0 edit-color-btn"
                onclick="selectEditCardTheme(this, 'cat-lifestyle', 'linear-gradient(135deg, #ff9966, #ff5e62)', '#ffffff')"
                style="width:32px; height:32px; background:linear-gradient(135deg, #ff9966, #ff5e62);"
                title="Lifestyle"></button>
              <button type="button" class="btn rounded-circle p-0 edit-color-btn"
                onclick="selectEditCardTheme(this, 'cat-social', 'linear-gradient(135deg, #833ab4, #fd1d1d, #fcb045)', '#ffffff')"
                style="width:32px; height:32px; background:linear-gradient(135deg, #833ab4, #fd1d1d, #fcb045);"
                title="Social"></button>
              <button type="button" class="btn rounded-circle p-0 edit-color-btn"
                onclick="selectEditCardTheme(this, 'cat-entertainment', 'linear-gradient(135deg, #6a11cb, #2575fc)', '#ffffff')"
                style="width:32px; height:32px; background:linear-gradient(135deg, #6a11cb, #2575fc);"
                title="Divertissement"></button>
              <button type="button" class="btn rounded-circle p-0 edit-color-btn"
                onclick="selectEditCardTheme(this, 'cat-health', 'linear-gradient(135deg, #ff0844, #ffb199)', '#ffffff')"
                style="width:32px; height:32px; background:linear-gradient(135deg, #ff0844, #ffb199);"
                title="Santé"></button>
              <button type="button" class="btn rounded-circle p-0 edit-color-btn"
                onclick="selectEditCardTheme(this, 'cat-travel', 'linear-gradient(135deg, #2193b0, #6dd5ed)', '#ffffff')"
                style="width:32px; height:32px; background:linear-gradient(135deg, #2193b0, #6dd5ed);"
                title="Voyage"></button>
              <button type="button" class="btn rounded-circle p-0 edit-color-btn"
                onclick="selectEditCardTheme(this, 'cat-gaming', 'linear-gradient(135deg, #b06ab3, #4568dc)', '#ffffff')"
                style="width:32px; height:32px; background:linear-gradient(135deg, #b06ab3, #4568dc);"
                title="Gaming"></button>
            </div>
          </div>

          <!-- Zone Liste de Tâches Dynamique (Masquée par défaut) -->
          <div class="mb-3 d-none" id="editTodoChecklistContainer">
            <label class="form-label fw-semibold text-secondary d-flex justify-content-between align-items-center">
              Éléments de la checklist
              <button type="button" class="btn btn-sm btn-outline-primary border-0 rounded-circle"
                onclick="addEditChecklistItem()">
                <i class="fa fa-plus-circle fa-lg"></i>
              </button>
            </label>
            <div id="editChecklistFields" class="d-flex flex-column gap-2">
              <!-- Injecté dynamiquement en modification -->
            </div>
          </div>

          <!-- Gestion des médias existants -->
          <div class="mb-3">
            <label class="form-label fw-semibold text-secondary"><i class="fa fa-folder-open me-1"></i>Médias
              actuellement associés</label>
            <div id="editExistingAttachmentsZone" class="d-flex flex-wrap gap-2 p-2 bg-white rounded border">
              <!-- Reconstruit par JS -->
            </div>
          </div>

          <!-- Ajout de fichiers joints supplémentaires -->
          <div class="mb-3 mt-3">
            <label for="editAttachments" class="form-label fw-semibold text-secondary">
              <i class="fa fa-paperclip me-1"></i> Ajouter de nouvelles pièces jointes
            </label>
            <input class="form-control border-0 shadow-sm" type="file" id="editAttachments" name="attachments" multiple>
          </div>

          <!-- Le conteneur d'aperçu des nouveaux médias reste inchangé et identique -->
          <div id="editMediaPreviewContainer" class="mb-3 d-none">
            <label class="form-label fw-semibold text-success">Aperçu des nouveaux fichiers ajoutés :</label>
            <div id="editMediaPreview" class="d-flex flex-wrap gap-2 p-2 bg-white rounded border"></div>
          </div>


          <!-- Tags & Options Rapides -->
          <!-- Block 1: Options Rapides (Switches alignés Gauche / Droite) -->
          <div
            class="d-flex justify-content-between align-items-center mt-4 mb-3 p-2 bg-white rounded border shadow-sm">
            <!-- Interrupteur Épingler (À gauche) -->
            <div class="form-check form-switch m-0">
              <input class="form-check-input" type="checkbox" role="switch" id="editIsPinned" name="isPinned"
                value="true">
              <label class="form-check-label fw-medium text-dark" for="editIsPinned">
                <i class="fa fa-thumbtack me-1 text-secondary"></i> Épingler
              </label>
            </div>

            <!-- Interrupteur Confidentialité (À droite) -->
            <div class="form-check form-switch m-0">
              <input class="form-check-input" type="checkbox" role="switch" id="editIsPrivate" name="isPrivate"
                value="true">
              <label class="form-check-label fw-medium text-dark" for="editIsPrivate">
                <i class="fa fa-eye-slash me-1 text-secondary"></i> Rendre cette note privée
              </label>
            </div>
          </div>

          <!-- Block 2: Gestion des Tags (En dessous) -->
          <div class="mb-3">
            <label for="editTags" class="form-label fw-semibold text-secondary">Tags (séparés par une virgule)</label>
            <input type="text" class="form-control border-0 shadow-sm" id="editTags" name="tags"
              placeholder="travail, important">
          </div>


        </div>

        <div class="modal-footer bg-white border-0 p-3 shadow-sm d-flex justify-content-end gap-2">
          <button type="button" class="btn btn-light px-4 fw-semibold" data-bs-dismiss="modal">Annuler</button>
          <button type="submit" id="editSubmitButton"
            class="btn btn-primary px-4 fw-semibold shadow-sm">Enregistrer</button>
        </div>
      </form>

    </div>
  </div>
</div>