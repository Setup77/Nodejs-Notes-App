<link rel="stylesheet" href="/css/profile.css">
<div class="container my-5">
  <div class="row g-4">
    
    <!-- COLONNE GAUCHE : Carte Identité, Stats & Préférences Sécurité -->
    <div class="col-lg-4">
      <div class="card shadow border-0 overflow-hidden text-center profile-card mb-4">
        <!-- Bannière de couverture style réseau social -->
        <div class="profile-cover position-relative" style="height: 120px; background: linear-gradient(135deg, #4f46e5, #06b6d4);"></div>
        
        <div class="card-body position-relative pt-0">
          <!-- Avatar surélevé chevauchant la bannière -->
          <div class="avatar-container position-relative d-inline-block" style="margin-top: -60px; z-index: 5;">
            <img src="/img/<%= user.avatar || 'default-avatar.png' %>" id="avatarPreview" class="rounded-circle border border-4 border-white shadow" alt="Avatar" style="width: 120px; height: 120px; object-fit: cover;">
            
            <% if (userSession._id == id) { %>  
              <label for="avatarInput" class="btn btn-sm btn-light position-absolute bottom-0 end-0 rounded-circle shadow-sm" style="width: 32px; height: 32px; padding: 0; display: flex; align-items: center; justify-content: center; cursor: pointer;">
                <i class="bi bi-camera-fill text-primary"></i>
              </label>
              <input type="file" id="avatarInput" accept="image/*" hidden>
            <% } %>
          </div>

          <h4 class="mt-3 mb-1 fw-bold"><%= user.lastName %> <%= user.firstName %></h4>
          <p class="text-uppercase tracking-wider small fw-semibold text-secondary mb-3"><%= user.role || 'Membre' %></p>
          
          <!-- Badges de rôles -->
          <div class="mb-4">
            <span class="badge bg-light text-primary border border-primary-subtle px-3 py-2 rounded-pill">
              <i class="bi bi-shield-check me-1"></i> <%= user.role === 'Admin' ? 'Administrateur' : 'Contributeur' %>
            </span>
          </div>

          <!-- Section Statistiques Dynamiques basées sur vos modèles Mongoose -->
          <div class="d-flex justify-content-around border-top border-bottom py-3 my-3 bg-light rounded-3">
            <div>
              <h5 class="mb-0 fw-bold text-dark"><%= stats.noteCount %></h5>
              <small class="text-muted text-xs">Notes</small>
            </div>
            <div class="border-start"></div>
            <div>
              <h5 class="mb-0 fw-bold text-dark"><%= stats.categoryCount %></h5>
              <small class="text-muted text-xs">Catégories</small>
            </div>
            <div class="border-start"></div>
            <div>
              <h5 class="mb-0 fw-bold text-dark"><%= stats.commentCount %></h5>
              <small class="text-muted text-xs">Commentaires</small>
            </div>
          </div>
        </div>
      </div>

      <!-- Bloc Sécurité & Préférences (Données du Modèle User) -->
      <div class="card shadow border-0 p-4">
        <h6 class="fw-bold mb-3 text-start"><i class="bi bi-gear-fill text-secondary me-2"></i>Paramètres du Compte</h6>
        
        <!-- Code PIN Sécurité -->
        <div class="d-flex justify-content-between align-items-center mb-3 p-2 bg-light rounded">
          <span class="small fw-medium"><i class="bi bi-lock-fill me-2 text-warning"></i>Notes Sensibles (PIN)</span>
          <% if (user.security && user.security.pinCode) { %>
            <span class="badge bg-success-subtle text-success">Activé</span>
          <% } else { %>
            <span class="badge bg-danger-subtle text-danger">Désactivé</span>
          <% } %>
        </div>

        <!-- Mode Sombre -->
        <div class="d-flex justify-content-between align-items-center p-2 bg-light rounded">
          <span class="small fw-medium"><i class="bi bi-moon-stars-fill me-2 text-primary"></i>Thème Sombre</span>
          <span class="badge bg-secondary-subtle text-secondary"><%= user.preferences && user.preferences.darkMode ? 'Oui' : 'Non' %></span>
        </div>
      </div>
    </div>

    <!-- COLONNE DROITE : Détails du profil et Tableau des Catégories -->
    <div class="col-lg-8">
      <!-- Bloc d'informations d'identité -->
      <div class="card shadow border-0 p-4 mb-4">
        <h5 class="card-title fw-bold mb-4 d-flex align-items-center">
          <i class="bi bi-person-lines-fill text-primary me-2"></i> Informations du Profil
        </h5>

        <div class="row g-3">
          <!-- Nom -->
          <div class="col-md-6">
            <div class="p-3 border rounded-3 d-flex justify-content-between align-items-center bg-white">
              <div>
                <small class="text-muted d-block text-uppercase fw-semibold" style="font-size: 0.75rem;">Nom</small>
                <span id="lastNameField" class="fw-medium text-dark"><%= user.lastName %></span>
              </div>
              <% if (userSession._id == id) { %>   
                <button class="btn btn-outline-secondary btn-sm rounded-circle border-0" onclick="openModal('lastName', '<%= user.lastName %>')">
                  <i class="bi bi-pencil"></i>
                </button>
              <% } %>
            </div>
          </div>

          <!-- Prénom -->
          <div class="col-md-6">
            <div class="p-3 border rounded-3 d-flex justify-content-between align-items-center bg-white">
              <div>
                <small class="text-muted d-block text-uppercase fw-semibold" style="font-size: 0.75rem;">Prénom</small>
                <span id="firstNameField" class="fw-medium text-dark"><%= user.firstName %></span>
              </div>
              <% if (userSession._id == id) { %>  
                <button class="btn btn-outline-secondary btn-sm rounded-circle border-0" onclick="openModal('firstName', '<%= user.firstName %>')">
                  <i class="bi bi-pencil"></i>
                </button>
              <% } %>
            </div>
          </div>

          <!-- Adresse Email (VERROUILLÉE : NON MODIFIABLE) -->
          <div class="col-12">
            <div class="p-3 border rounded-3 d-flex justify-content-between align-items-center bg-white">
              <div>
                <small class="text-muted d-block text-uppercase fw-semibold" style="font-size: 0.75rem;">Adresse Email</small>
                <span id="emailField" class="fw-medium text-dark"><%= user.email %></span>
              </div>
            </div>
          </div>

          <!-- Profession / Rôle -->
          <div class="col-12">
            <div class="p-3 border rounded-3 d-flex justify-content-between align-items-center bg-white">
              <div>
                <small class="text-muted d-block text-uppercase fw-semibold" style="font-size: 0.75rem;">Profession / Rôle</small>
                <span id="roleField" class="fw-medium text-dark"><%= user.role %></span>
              </div>
              <% if (userSession._id == id) { %>  
                <button class="btn btn-outline-secondary btn-sm rounded-circle border-0" onclick="openModal('role', '<%= user.role %>')">
                  <i class="bi bi-pencil"></i>
                </button>
              <% } %>
            </div>
          </div>
        </div>
      </div>

      <!-- Bloc d'affichage des Catégories de l'utilisateur (Modèle Category) -->
      <div class="card shadow border-0 p-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <h5 class="card-title fw-bold m-0 d-flex align-items-center">
            <i class="bi bi-tags-fill text-success me-2"></i> Mes espaces & Catégories
          </h5>
        </div>
        
        <% if (categories && categories.length > 0) { %>
          <div class="d-flex flex-wrap gap-2">
            <% categories.forEach(category => { %>
              <span class="badge px-3 py-2 rounded-pill shadow-sm text-white border" style="background-color: <%= category.color %>;">
                <i class="bi bi-folder2-open me-1"></i> <%= category.name %>
              </span>
            <% }) %>
          </div>
        <% } else { %>
          <p class="text-muted small my-2">Aucune catégorie de notes créée pour le moment.</p>
        <% } %>
      </div>
    </div>

  </div>
</div>

  <!-- ✅ Les modales et les éléments système restent identiques ci-dessous -->
  <div class="modal fade" id="editModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-0 shadow-lg">
      <div class="modal-header bg-light border-0 py-3">
        <h5 class="modal-title fw-bold text-dark"><i class="bi bi-pencil-square text-primary me-2"></i>Modifier le champ</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body p-4">
        <form id="editForm">
          <input type="hidden" id="fieldName">
          <div class="form-floating mb-3">
            <input type="text" id="editInput" class="form-control rounded-3" placeholder="Nouvelle valeur" required>
            <label for="editInput">Saisissez la modification</label>
          </div>
          <button class="btn btn-primary w-100 py-2 rounded-3 fw-semibold" type="submit">Sauvegarder les modifications</button>
        </form>
      </div>
    </div>
  </div>
</div>

<div id="loadingOverlay" class="position-fixed top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center bg-dark bg-opacity-50 d-none" style="z-index: 2000; backdrop-filter: blur(4px);">
  <div class="spinner-border text-light" style="width: 3rem; height: 3rem;" role="status">
    <span class="visually-hidden">Chargement...</span>
  </div>
</div>

<div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1055;">
  <div id="liveToast" class="toast align-items-center text-bg-success border-0 shadow-lg" role="alert" aria-live="assertive" aria-atomic="true">
    <div class="d-flex p-2">
      <div class="toast-body d-flex align-items-center" id="toastMessage"></div>
      <button type="button" class="btn-close btn-close-white m-auto me-2" data-bs-dismiss="toast"></button>
    </div>
  </div>
</div>

<script src="/js/profile.js"></script>
