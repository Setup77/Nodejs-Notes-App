      </p>

      <!-- Bouton Retour -->
      <a href="/" class="btn btn-primary btn-lg rounded-pill px-4 shadow-sm">
        <i class="fa fa-home me-2"></i>Retour à l'accueil
      </a>
    </div>
  </div>
</div>