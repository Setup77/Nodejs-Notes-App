<div class="container my-5 py-5">
  <div class="row justify-content-center align-items-center min-vh-50">
    <div class="col-md-6 text-center">
      <!-- Illustration Icone (Utilise FontAwesome déjà chargé dans votre layout) -->
      <div class="mb-4">
        <i class="fa fa-exclamation-triangle text-warning display-1 animate-pulse"></i>
      </div>

      <!-- Code Erreur -->
      <h1 class="display-1 fw-black text-gradient mb-2">404</h1>

      <!-- Message -->
